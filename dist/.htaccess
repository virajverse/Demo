Options -Indexes

RewriteEngine On
RewriteBase /

# Redirect everything in demos/ to router.php
# We check if it is a file or directory to avoid loops, but since we are rewriting TO router.php which is NOT in demos/, it is safe.
# Actually, router.php is in /dist/. /dist/demos/xxxx -> /dist/router.php
# We use REQUEST_URI in PHP to handle paths with spaces correctly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^demos/ router.php [L]

# Main landing page
RewriteRule ^$ index.php [L]
