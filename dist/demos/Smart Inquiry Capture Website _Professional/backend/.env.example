# ===================================
# SMART INQUIRY BACKEND - ENVIRONMENT VARIABLES
# ===================================
# Copy this file to .env and fill in your actual values

# ===================================
# SERVER CONFIGURATION
# ===================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ===================================
# DATABASE (PostgreSQL)
# ===================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_inquiry
DB_USER=postgres
DB_PASSWORD=your_database_password

# Alternative: Full connection string
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_inquiry

# ===================================
# JWT AUTHENTICATION
# ===================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===================================
# WHATSAPP CLOUD API (Meta)
# ===================================
# Get these from: https://developers.facebook.com/apps
WHATSAPP_CLOUD_API_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_for_webhook

# WhatsApp API Base URL
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# ===================================
# SMS PROVIDER (MSG91)
# ===================================
# Get API key from: https://msg91.com
SMS_PROVIDER=msg91
MSG91_API_KEY=your_msg91_api_key
MSG91_SENDER_ID=TALTECH
MSG91_ROUTE=4
MSG91_TEMPLATE_ID=your_approved_template_id

# Alternative: Twilio
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ===================================
# EMAIL SERVICE
# ===================================
# Option 1: SMTP (Gmail, Outlook, etc.)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
EMAIL_FROM=Smart Inquiry <noreply@taliyotech.com>

# Option 2: SendGrid
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your_sendgrid_api_key

# ===================================
# GOOGLE CALENDAR API
# ===================================
# Get credentials from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/google/callback

# ===================================
# OUTLOOK CALENDAR API
# ===================================
# Get credentials from: https://portal.azure.com
OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret
OUTLOOK_REDIRECT_URI=http://localhost:5000/api/calendar/outlook/callback
OUTLOOK_TENANT_ID=common

# ===================================
# CRM INTEGRATION
# ===================================
CRM_WEBHOOK_URL=https://your-crm.com/api/webhook
CRM_API_KEY=your_crm_api_key
CRM_ENABLED=false

# ===================================
# ADMIN CREDENTIALS (Initial Setup)
# ===================================
DEFAULT_ADMIN_EMAIL=admin@taliyotech.com
DEFAULT_ADMIN_PASSWORD=ChangeThisPassword123!
DEFAULT_ADMIN_NAME=System Administrator

# ===================================
# REMINDER SETTINGS
# ===================================
# How many hours before booking to send reminder
REMINDER_HOURS_BEFORE=24

# Cron schedule for reminder job (runs daily at 9 AM)
REMINDER_CRON_SCHEDULE=0 9 * * *

# Enable/disable reminder types
ENABLE_EMAIL_REMINDERS=true
ENABLE_SMS_REMINDERS=false
ENABLE_WHATSAPP_REMINDERS=true

# ===================================
# BOOKING SETTINGS
# ===================================
# Default booking duration in minutes
DEFAULT_BOOKING_DURATION=60

# Buffer time between bookings (minutes)
BUFFER_TIME_MINUTES=15

# Maximum advance booking days
MAX_ADVANCE_BOOKING_DAYS=90

# Minimum advance booking hours
MIN_ADVANCE_BOOKING_HOURS=2

# ===================================
# RATE LIMITING
# ===================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================================
# LOGGING
# ===================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# ===================================
# SECURITY
# ===================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Session secret
SESSION_SECRET=your_session_secret_key

# ===================================
# FEATURE FLAGS
# ===================================
ENABLE_ANALYTICS=true
ENABLE_CRM_SYNC=false
ENABLE_CALENDAR_SYNC=true
ENABLE_MULTI_STAFF=true

# ===================================
# DEVELOPMENT/DEBUG
# ===================================
DEBUG_MODE=false
ENABLE_API_DOCS=true
MOCK_EXTERNAL_APIS=false
